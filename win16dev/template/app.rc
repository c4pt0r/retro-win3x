#include <windows.h>
#include "resource.h"

IDI_APP ICON "app.ico"

IDM_MAIN MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "E&xit",       IDM_EXIT
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About...",   IDM_ABOUT
    END
END

IDD_ABOUT DIALOG 20, 20, 160, 70
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About"
FONT 8, "MS Sans Serif"
BEGIN
    ICON            IDI_APP, -1, 10, 10, 18, 20
    LTEXT           "App 1.0", -1, 40, 10, 110, 8
    LTEXT           "Cross-compiled on Linux with Open Watcom", -1, 40, 22, 110, 18
    DEFPUSHBUTTON   "OK", IDOK, 55, 48, 50, 14
END
