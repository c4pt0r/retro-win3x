#!/usr/bin/env bash
# w16run — copy a Win16 exe into the Windows 3.1 VM, launch it, take a screenshot.
#
#   w16run [-w SECS] [-o SHOT.png] [-n] APP.EXE [args...]
#
# Transfers via w31x (floppy A:), then asks W16AGENT.EXE (over COM1, see
# w16ctl) to close any old instance, copy the exe to C:\W16RUN and start it.
set -euo pipefail

W31=${W31_DIR:-$HOME/win31}
SOCK=$W31/qemu-monitor.sock
WAIT=3 SHOT=w16run.png NOSHOT=0

usage() { sed -n '2,8s/^# \{0,1\}//p' "$0"; exit 1; }

while getopts "w:o:nh" opt; do
    case $opt in
    w) WAIT=$OPTARG ;;
    o) SHOT=$OPTARG ;;
    n) NOSHOT=1 ;;
    *) usage ;;
    esac
done
shift $((OPTIND - 1))
(( $# )) || usage
EXE=$1; shift
[[ -f $EXE ]] || { echo "w16run: $EXE not found" >&2; exit 1; }

mon() {
    printf '%s\n' "$1" | socat -t1 - "UNIX-CONNECT:$SOCK" >/dev/null 2>&1
}
mon "info status" || { echo "w16run: VM not running (start ~/win31/run.sh)" >&2; exit 1; }

out=$(w31x put "$EXE")
DOSEXE=${out##*A:\\}                     # name w31x gave it on A:
w16ctl RUN "A:\\$DOSEXE${*:+ $*}"

if (( ! NOSHOT )); then
    sleep "$WAIT"
    tmp=$(mktemp -d)/shot.ppm
    mon "screendump $tmp"; sleep 0.5
    magick "$tmp" "$SHOT"; rm -rf "$(dirname "$tmp")"
    echo "screenshot: $SHOT"
fi
